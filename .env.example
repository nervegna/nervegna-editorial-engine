# Anthropic API (for Claude-powered content generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email notification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nervegna.tommaso@gmail.com
SMTP_PASS=your_app_password_here
NOTIFICATION_EMAIL=nervegna.tommaso@gmail.com

# RSS Feeds
SUBSTACK_FEEDS=https://feed1.substack.com,https://feed2.substack.com
MEDIUM_FEEDS=https://medium.com/feed/@user1,https://medium.com/feed/@user2

# GitHub
GITHUB_TOKEN=your_github_token_here

# Twitter alternatives (Mastodon, Bluesky)
MASTODON_INSTANCE=https://mastodon.social
MASTODON_TOKEN=your_mastodon_token
BLUESKY_HANDLE=your_handle
BLUESKY_PASSWORD=your_password

# Scheduler
CRON_SCHEDULE=0 */72 * * *

# Scoring thresholds
MIN_ENGAGEMENT_SCORE=0.3
MIN_RELEVANCE_SCORE=0.6

# Content generation
TARGET_READING_TIME_MIN=6
TARGET_READING_TIME_MAX=10
WORDS_PER_MINUTE=200

# Editorial POV keywords
POV_KEYWORDS=agentic AI,AI-native,generative AI,design strategico,product design,agent systems
